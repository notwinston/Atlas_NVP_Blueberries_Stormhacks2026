<Project Sdk="Microsoft.NET.Sdk">

  <!-- ReplayPhone: plays a recorded state.bin, or a synthetic walk, into a Hub as the phone (Master Plan Appendix C.8). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ReplayPhone</AssemblyName>
    <RootNamespace>Atlas.Tools</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The app's own link sources and the Hub's state.bin layout, so the three can never disagree about a byte. -->
  <ItemGroup>
    <Compile Include="../../ATLAS/Assets/Atlas/Link/**/*.cs" LinkBase="Atlas.Link" />
    <Compile Include="../../station/hub/Logging/StateLog.cs" Link="Station/StateLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
  </ItemGroup>

</Project>
