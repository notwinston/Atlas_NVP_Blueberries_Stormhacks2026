<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lane A engine-free cores of the Lung Mission (P2-A20, A22, A24, A27, A28, A29).
       Plain C#, System only, netstandard2.1 + C# 9 (what Unity 6 compiles): the .cs files move into the
       app unchanged. See README.md. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Atlas.Lung.Core</RootNamespace>
    <AssemblyName>Atlas.Lung.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Atlas.Cases/Atlas.Cases.csproj" />
  </ItemGroup>
</Project>
