<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain C# with no Unity references. netstandard2.1 + C# 9 is what Unity 6 compiles, so the
       .cs files of this folder can be moved into the app unchanged (lane A). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Atlas.Cases</RootNamespace>
    <AssemblyName>Atlas.Cases</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
