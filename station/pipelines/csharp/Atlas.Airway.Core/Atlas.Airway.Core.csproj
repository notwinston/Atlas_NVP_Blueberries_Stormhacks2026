<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain C# with no Unity references (System only, plus Atlas.Cases for the JSON reader of tree.json).
       netstandard2.1 + C# 9 is what Unity 6 compiles, so the .cs files of this folder can be moved
       into the app unchanged (lane B, assembly Atlas.Spaces.Lung or the like; see README.md). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Atlas.Airway</RootNamespace>
    <AssemblyName>Atlas.Airway.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Atlas.Cases/Atlas.Cases.csproj" />
  </ItemGroup>
</Project>
